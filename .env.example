# --- Gemini (required) -------------------------------------------------
# Copy to .env.local and add your key from https://aistudio.google.com/apikey
# (You can also paste the key in the in-app Settings ⚙️ instead.)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- Supabase (optional) -----------------------------------------------
# Set both to sync version history to Postgres instead of this browser.
# Find them at Supabase → Project Settings → API.
# Leave them blank and Inkwell falls back to localStorage automatically.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
